// Parameterized CD pipeline: deploys the artifact from a chosen main-branch CI build.
// Create a normal "Pipeline" job (not multibranch) that uses this file as its script path.
// It never runs "npm run build" - it only deploys what CI produced.
pipeline {
    agent any

    parameters {
        string(name: 'CI_BUILD_NUMBER', defaultValue: '', description: 'Build number of the main-branch CI job whose artifact is deployed')
        choice(name: 'ENVIRONMENT', choices: ['DEV', 'TEST', 'ACC', 'PROD'], description: 'Target environment')
    }

    environment {
        // Full name of the main branch job inside the Multibranch project
        CI_JOB = 'budget-tracker-ci/main'
    }

    stages {
        stage('Validate') {
            steps {
                script {
                    if (!params.CI_BUILD_NUMBER?.trim().isInteger()) {
                        error('CI_BUILD_NUMBER must be a number')
                    }
                    echo "Deploying CI build #${params.CI_BUILD_NUMBER} to ${params.ENVIRONMENT}"
                }
            }
        }

        stage('Approve PROD') {
            when { expression { params.ENVIRONMENT == 'PROD' } }
            steps {
                input message: "Deploy CI build #${params.CI_BUILD_NUMBER} to PROD?", ok: 'Deploy'
            }
        }

        stage('Fetch Artifact') {
            steps {
                deleteDir()
                copyArtifacts projectName: env.CI_JOB,
                              selector: specific(params.CI_BUILD_NUMBER),
                              filter: "react-app-${params.CI_BUILD_NUMBER}.tar.gz"
                sh "mkdir app && tar -xzf react-app-${params.CI_BUILD_NUMBER}.tar.gz -C app"
            }
        }

        stage('Deploy') {
            steps {
                script {
                    def ports = [DEV: 8081, TEST: 8082, ACC: 8083, PROD: 8084]
                    def port  = ports[params.ENVIRONMENT]
                    def name  = "budget-tracker-${params.ENVIRONMENT.toLowerCase()}"
                    def image = "budget-tracker:${params.ENVIRONMENT.toLowerCase()}-${params.CI_BUILD_NUMBER}"

                    sh """
                        docker build -t ${image} app
                        docker rm -f ${name} || true
                        docker run -d --name ${name} -p ${port}:80 ${image}
                    """
                    echo "CI build ${params.CI_BUILD_NUMBER} deployed to ${params.ENVIRONMENT}: http://localhost:${port}"
                }
            }
        }
    }
}
